{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(cargo: *)",
      "Bash(curl:*)",
      "Bash(rustc:*)",
      "Bash(docker run:*)",
      "Bash(nix:*)",
      "Bash(go:*)",
      "Bash(python:*)",
      "Bash(npm:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"git commit\"",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/conventional-commit/validate.sh"
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/channinghe/.ccs/hooks/websearch-transformer.cjs\"",
            "timeout": 85
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    }
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "ecc@ecc": true
  },
  "companyAnnouncements": [
    "Welcome!"
  ],
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "description": "Persistent memory across sessions"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "description": "Chain-of-thought reasoning"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context7/mcp-server"
      ],
      "description": "Live documentation lookup"
    },
    "grep": {
      "command": "npx",
      "args": [
        "-y",
        "@grepapp/mcp-server"
      ],
      "description": "Code search and context"
    },
    "websearch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-websearch"
      ],
      "description": "Web search"
    }
  },
  "tui": "fullscreen"
}
